# CampusLingo environment template.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# The service reads plain environment variables (no auto-loading), so export the
# file before starting uvicorn, or pass the values through your process manager.
# Every value below is the built-in default — change only what you need.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Async SQLAlchemy DSN. The docker-compose stack matches this default.
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/campuslingo
# Log every SQL statement (very noisy; debugging only).
# SQL_ECHO=1
# Connection pool sizing.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Ollama / Qwen
# ---------------------------------------------------------------------------
# Base URL of the Ollama server. Point this at the GPU rig if it runs elsewhere.
OLLAMA_HOST=http://localhost:11434

# Model for the PRIMARY path (one schema-constrained bundle per lecture chunk).
# Spec default is qwen2.5:7b; on the RTX 5070 rig use qwen3.5:9b.
OLLAMA_BUNDLE_MODEL=qwen2.5:7b

# Model for the FALLBACK path (one constrained call per challenge type).
OLLAMA_MODEL=qwen2.5:7b-instruct

# Embedding model for node vectors. `ollama pull nomic-embed-text` to enable;
# without it units still persist and the failure is reported per chunk.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Must match learning_nodes.embedding vector(1536). Shorter vectors are
# zero-padded and L2-normalised to fit.
EMBEDDING_DIM=1536

# Seconds to wait for a single generation request. A 9B model on CPU-only
# hardware can exceed 300s — raise this on slow hosts, lower it on the GPU rig.
OLLAMA_TIMEOUT=300

# Seconds to wait for an embedding request.
OLLAMA_EMBED_TIMEOUT=120

# Attempts per challenge/unit (each retry carries the validator error back to
# the model). Exhausted attempts drop that challenge and are reported, never stored.
OLLAMA_MAX_ATTEMPTS=3

# Lecture characters sent per request.
OLLAMA_MAX_SOURCE_CHARS=7000

# true = let the model emit reasoning traces. Default false: the answer is
# already schema-constrained and traces only add latency.
OLLAMA_THINK=false

# ---------------------------------------------------------------------------
# Ingestion limits
# ---------------------------------------------------------------------------
# PDF upload ceiling in bytes (84 MiB ~= 83886080).
MAX_UPLOAD_BYTES=83886080
# Chunks converted into learning units per upload.
MAX_NODES_PER_LECTURE=25
# Chunks generated in parallel during an upload (each one is a model call).
GENERATION_CONCURRENCY=2

# ---------------------------------------------------------------------------
# HTTP / logging
# ---------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Only used by the `python -m main` development entrypoint.
HOST=0.0.0.0
PORT=8000
# RELOAD=1

# ---------------------------------------------------------------------------
# Frontend (apps/web) — copy these into apps/web/.env.local
# ---------------------------------------------------------------------------
# API base URL as seen by the BROWSER. Must be reachable from the user's machine.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side target for the /backend/* rewrite proxy in next.config.mjs.
BACKEND_ORIGIN=http://localhost:8000
